# Telegram
TELEGRAM_BOT_TOKEN=your_token_here
BOT_NAME=Агета

# AI Provider: groq | gemini | cerebras
AI_PROVIDER=groq

# Groq (можно до 10 ключей для ротации)
GROQ_API_KEY=gsk_xxxxxxxx
GROQ_API_KEY_2=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Cerebras
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# Admins (через запятую)
ADMIN_IDS=123456789

# Group settings
GROUP_CHAT_ENABLED=yes
MENTION_REQUIRED=yes
ALLOWED_TOPIC_ID=

# Anti-flood
ANTI_FLOOD_SECONDS=2
MAX_MESSAGES_PER_MINUTE=30
MAX_HISTORY=50
